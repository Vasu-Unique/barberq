PROJECT_NAME="BarberQ API"
ENVIRONMENT=development
DEBUG=True
API_V1_STR=/api/v1

# Database Configuration
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_USER=barberq
POSTGRES_PASSWORD=barberq_password
POSTGRES_DB=barberq_db
DATABASE_URL=postgresql+asyncpg://barberq:barberq_password@postgres:5432/barberq_db

# Security & JWT
JWT_SECRET=super-secret-barberq-jwt-key-change-in-production-min32chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:8080","http://127.0.0.1:5173","http://127.0.0.1:8080"]
